@page "{id:int}"
@model TalentPlus.Web.Pages.EditModel
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fa-solid fa-user-pen me-2"></i>Editar Empleado</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Employee.Id" />
                    <input type="hidden" asp-for="Employee.HiringDate" />
                    <input type="hidden" asp-for="Employee.DocumentNumber" /> <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombres</label>
                            <input asp-for="Employee.FirstName" class="form-control" />
                            <span asp-validation-for="Employee.FirstName" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Apellidos</label>
                            <input asp-for="Employee.LastName" class="form-control" />
                            <span asp-validation-for="Employee.LastName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Employee.Email" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono</label>
                            <input asp-for="Employee.Phone" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cargo</label>
                            <input asp-for="Employee.Position" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Salario</label>
                            <input asp-for="Employee.Salary" class="form-control" type="number" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Departamento</label>
                            <select asp-for="Employee.DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
                                <option value="">-- Seleccionar --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Estado</label>
                            <select asp-for="Employee.Status" class="form-select">
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                                <option value="Vacaciones">Vacaciones</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/Employees" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}